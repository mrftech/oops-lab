{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oopslab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker (and bills as a Worker request); everything else is a free static asset.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oopslab",
      // Run `npx wrangler d1 create oopslab` and paste the returned id here before deploying.
      // Local dev works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
