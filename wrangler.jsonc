{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oops-lab",
  // TawhidMaruf (Personal). Pinned so local Wrangler commands can't hit another account.
  "account_id": "fb5fb655a663a60fbc82092d8af3e187",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Main site on the root domain. Cloudflare creates the DNS record and certificate on deploy.
  // Exact hostname only (no wildcard): future projects get their own Worker + subdomain.
  "routes": [{ "pattern": "oopslab.xyz", "custom_domain": true }],
  // Only reachable through oopslab.xyz, so the zone's rate-limit rule can't be bypassed via *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: request and error visibility in the dashboard (Worker > Logs).
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker (and bills as a Worker request); everything else is a free static asset.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oopslab",
      "database_id": "589b1d7e-b5f0-4c58-baee-41158d62a9d8",
      "migrations_dir": "migrations"
    }
  ]
}
