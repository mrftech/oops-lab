{
  "name": "oopslab",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('This project uses pnpm. Run: pnpm install');process.exit(1)}\"",
    "dev": "astro dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "astro build",
    "preview": "astro build && wrangler dev --port 8787",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply oopslab --local",
    "db:migrate": "wrangler d1 migrations apply oopslab --remote",
    "cf:deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "astro": "^7.4.13",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.165.0"
  }
}
