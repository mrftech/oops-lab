---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Oops — nothing here · OopsLab" description="This page doesn't exist. Which is, fittingly, an oops.">
  <section class="container lost">
    <div class="four04" aria-hidden="true">404</div>
    <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Page not found</h1>
    <p>Oops. That page wandered off. It happens in a lab; at least this one is a good one for the museum.</p>
    <div class="buttons" style="justify-content:center"><a class="button dark" href="/">Back to the lab <span>↗</span></a></div>
  </section>
</Layout>
